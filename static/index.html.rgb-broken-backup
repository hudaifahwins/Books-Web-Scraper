                            <div class="text-xl font-semibold text-white tabular-nums" id="price-range">--</div>
                        </div>
                        <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-md)] p-4">
                            <div class="text-[10px] font-semibold text-[var(--text-muted)] uppercase tracking-wide mb-1">Total Categories</div>
                            <div class="text-xl font-semibold text-white tabular-nums">3</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 flex-1 min-h-[400px]">
                        <!-- Price Distribution -->
                        <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-md)] p-6 flex flex-col">
                            <h3 class="text-[13px] font-semibold text-white mb-6">Price Distribution</h3>
                            <div class="flex-1 relative w-full flex items-center justify-center">
                                <canvas id="priceDistChart"></canvas>
                                <!-- Center Text Overlay -->
                                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                                    <span class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">Total</span>
                                    <span class="text-2xl font-semibold text-white tabular-nums" id="doughnut-center-count">0</span>
                                </div>
                            </div>
                        </div>
                        <!-- Top 5 Cheapest -->
                        <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-md)] p-6 flex flex-col">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-[13px] font-semibold text-white">Top 5 Cheapest Books</h3>
                                <span class="text-[11px] text-[var(--text-muted)] bg-[var(--bg-base)] px-2 py-1 rounded border border-[var(--border-subtle)]">Price (GBP)</span>
                            </div>
                            <div class="flex-1 relative w-full">
                                <canvas id="cheapestChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- STATUS BAR -->
    <footer class="h-8 bg-[var(--bg-base)] border-t border-[var(--border-subtle)] flex items-center justify-between px-6 text-[10px] text-[var(--text-muted)] z-20 shrink-0">
        <div class="flex items-center gap-4">
            <span class="flex items-center gap-1.5 font-medium"><div class="w-1.5 h-1.5 rounded-full bg-[var(--accent-emerald)]"></div> Systems Operational</span>
            <span class="hidden sm:inline">PostgreSQL v15</span>
        </div>
        <div class="flex items-center gap-4">
            <span id="latency" class="tabular-nums font-medium text-[var(--text-secondary)]">--ms</span>
            <span>v1.0.0</span>
        </div>
    </footer>

    <!-- COMMAND PALETTE -->
    <div id="commandPalette" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-start justify-center pt-[15vh]">
        <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-lg)] shadow-2xl w-full max-w-lg overflow-hidden fade-in">
            <div class="flex items-center px-4 py-3 border-b border-[var(--border-subtle)]">
                <svg class="w-4 h-4 text-[var(--text-muted)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" id="commandInput" placeholder="Search books..." class="w-full bg-transparent border-none text-white focus:outline-none placeholder-[var(--text-muted)] text-[13px]" autocomplete="off">
                <div class="text-[10px] text-[var(--text-muted)] border border-[var(--border-subtle)] rounded px-1.5 py-0.5 ml-2 font-mono">ESC</div>
            </div>
            <div class="max-h-[300px] overflow-y-auto p-2">
                <div class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold px-3 py-2">Quick Actions</div>
                <div class="flex items-center gap-3 px-3 py-2 hover:bg-[var(--bg-surface-hover)] rounded-[var(--radius-sm)] cursor-pointer transition-colors" onclick="switchTab('overview'); closeCommandPalette();">
                    <svg class="w-4 h-4 text-[var(--accent-indigo)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    <span class="text-[13px] text-[var(--text-primary)]">Go to Overview</span>
                </div>
                <div class="flex items-center gap-3 px-3 py-2 hover:bg-[var(--bg-surface-hover)] rounded-[var(--radius-sm)] cursor-pointer transition-colors" onclick="switchTab('analytics'); closeCommandPalette();">
                    <svg class="w-4 h-4 text-[var(--accent-indigo)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    <span class="text-[13px] text-[var(--text-primary)]">Go to Analytics</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        // =========================================
        // 1. STATE & UTILITIES
        // =========================================
        const State = {
            allData: [],
            currentSort: { key: 'price', asc: false },
            charts: { main: null, analytics: [] }
        };

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => { clearTimeout(timeout); func(...args); };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // =========================================
        // 2. DOM & NAVIGATION
        // =========================================
        function toggleCommandPalette() {
            const modal = document.getElementById('commandPalette');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) document.getElementById('commandInput').focus();
        }
        function closeCommandPalette() { document.getElementById('commandPalette').classList.add('hidden'); }

        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); toggleCommandPalette(); }
            if (e.key === 'Escape') closeCommandPalette();
        });

        function switchTab(tab) {
            document.getElementById('view-overview').classList.add('hidden');
            document.getElementById('view-analytics').classList.add('hidden');
            document.getElementById('view-' + tab).classList.remove('hidden');
            document.getElementById('breadcrumb-active').innerText = tab.charAt(0).toUpperCase() + tab.slice(1);

            const btnOverview = document.getElementById('nav-overview');
            const btnAnalytics = document.getElementById('nav-analytics');
            
            const activeClass = "flex items-center gap-3 px-3 py-2 rounded-[var(--radius-sm)] bg-[var(--bg-surface)] text-white text-[13px] font-medium border border-[var(--border-subtle)] transition-all w-full text-left";
            const inactiveClass = "flex items-center gap-3 px-3 py-2 rounded-[var(--radius-sm)] text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-surface-hover)] text-[13px] font-medium border border-transparent transition-all w-full text-left";

            if (tab === 'overview') {
                btnOverview.className = activeClass;
                btnOverview.querySelector('svg').classList.add('text-[var(--accent-indigo)]');
                btnAnalytics.className = inactiveClass;
                btnAnalytics.querySelector('svg').classList.remove('text-[var(--accent-indigo)]');
            } else {
                btnAnalytics.className = activeClass;
                btnAnalytics.querySelector('svg').classList.add('text-[var(--accent-indigo)]');
                btnOverview.className = inactiveClass;
                btnOverview.querySelector('svg').classList.remove('text-[var(--accent-indigo)]');
                renderAnalytics();
            }
        }

        // =========================================
        // 3. DATA FETCHING & CALCULATIONS
        // =========================================
        async function initDashboard() {
            try {
                const t0 = performance.now();
                const res = await fetch('/books?limit=1000');
                const data = await res.json();
                const t1 = performance.now();
                
                document.getElementById('latency').innerText = Math.round(t1 - t0) + 'ms';
                State.allData = data;
                updateUI();

                document.getElementById('commandInput').addEventListener('input', debounce((e) => {
                    const query = e.target.value.toLowerCase();
                    const filtered = State.allData.filter(b => b.title.toLowerCase().includes(query));
                    updateUI(filtered);
                    closeCommandPalette();
                }, 150));
            } catch (e) { console.error("API Error:", e); }
        }

        function updateUI(dataToRender = State.allData) {
            const tbody = document.getElementById('table-body');
            const emptyState = document.getElementById('table-empty');

            if (dataToRender.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
            } else {
                emptyState.classList.add('hidden');
                emptyState.classList.remove('flex');
            }

            // KPI Calculations
            const total = dataToRender.length;
            const sum = dataToRender.reduce((acc, book) => acc + book.price, 0);
            const avg = total ? (sum / total) : 0;
            const sortedPrices = [...dataToRender].sort((a, b) => a.price - b.price);
            
            const min = total ? sortedPrices[0].price : 0;
            const max = total ? sortedPrices[total - 1].price : 0;
            
            // Median Calculation
            let median = 0;
            if (total > 0) {
                const mid = Math.floor(total / 2);
                median = total % 2 !== 0 ? sortedPrices[mid].price : (sortedPrices[mid - 1].price + sortedPrices[mid].price) / 2;
            }

            // Update DOM
            document.getElementById('total-books').innerText = total.toLocaleString();
            document.getElementById('avg-price').innerText = '£' + avg.toFixed(2);
            document.getElementById('max-price').innerText = '£' + max.toFixed(2);
            
            // Update Analytics KPIs
            document.getElementById('median-price').innerText = '£' + median.toFixed(2);
            document.getElementById('min-price').innerText = '£' + min.toFixed(2);
            document.getElementById('price-range').innerText = '£' + (max - min).toFixed(2);
            document.getElementById('doughnut-center-count').innerText = total.toLocaleString();

            renderTable(dataToRender);
            
            const top10 = [...dataToRender].sort((a, b) => b.price - a.price).slice(0, 10);
            renderChart(top10);
        }

        // =========================================
        // 4. TABLE RENDERING
        // =========================================
        function renderTable(data) {
            const tbody = document.getElementById('table-body');
            const sortedData = [...data].sort((a, b) => {
                if (State.currentSort.key === 'title') {
                    return State.currentSort.asc ? a.title.localeCompare(b.title) : b.title.localeCompare(a.title);
                } else {
                    return State.currentSort.asc ? a.price - b.price : b.price - a.price;
                }
            });

            const rows = sortedData.map(book => `
                <tr class="hover:bg-[var(--bg-surface-hover)] transition-colors group cursor-pointer border-b border-[var(--border-subtle)]">
                    <td class="px-5 py-3 text-[var(--text-secondary)] group-hover:text-white truncate">${book.title}</td>
                    <td class="px-5 py-3 text-right text-[var(--text-secondary)] group-hover:text-white font-mono tabular-nums">£${book.price.toFixed(2)}</td>
                </tr>
            `).join('');
            
            tbody.innerHTML = rows;
            
            document.getElementById('sort-icon-title').innerText = State.currentSort.key === 'title' ? (State.currentSort.asc ? '↑' : '↓') : '';
            document.getElementById('sort-icon-price').innerText = State.currentSort.key === 'price' ? (State.currentSort.asc ? '↑' : '↓') : '';
        }

        function sortTable(key) {
            if (State.currentSort.key === key) { State.currentSort.asc = !State.currentSort.asc; } else { State.currentSort.key = key; State.currentSort.asc = true; }
            const query = document.getElementById('commandInput').value.toLowerCase();
            const filtered = State.allData.filter(b => b.title.toLowerCase().includes(query));
            updateUI(filtered);
        }

        // =========================================
        // 5. CHART.JS CONFIGURATIONS (MNC Grade)
        // =========================================
        
        const priceLabelPlugin = {
            id: 'priceLabel',
            afterDatasetsDraw(chart) {
                if (chart.config.type !== 'bar') return;
                const { ctx } = chart;
                ctx.save();
                ctx.font = '500 11px Inter';
                ctx.fillStyle = '#a1a1aa'; 
                ctx.textAlign = 'left';
                ctx.textBaseline = 'middle';
                
                chart.getDatasetMeta(0).data.forEach((bar, index) => {
                    const val = chart.data.datasets[0].data[index];
                    if (val !== undefined) {
                        ctx.fillText('£' + val.toFixed(2), bar.x + 8, bar.y);
                    }
                });
                ctx.restore();
            }
        };
        Chart.register(priceLabelPlugin);

        const tooltipConfig = {
            backgroundColor: 'rgba(18, 18, 20, 0.95)',
            titleColor: '#ededed',
            bodyColor: '#a1a1aa',
            borderColor: '#27272a',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 6,
            displayColors: false,
            titleFont: { family: 'Inter', size: 12, weight: '600' },
            bodyFont: { family: 'Inter', size: 12 }
        };

        function renderChart(top10) {
            const ctx = document.getElementById('booksChart').getContext('2d');
            
            if (State.charts.main) {
                State.charts.main.data.labels = top10.map(b => b.title);
                State.charts.main.data.datasets[0].data = top10.map(b => b.price);
                State.charts.main.update('none');
                return;
            }

            State.charts.main = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: top10.map(b => b.title),
                    datasets: [{
                        data: top10.map(b => b.price),
                        backgroundColor: '#6366f1',
                        borderRadius: 4,
                        borderSkipped: false,
                        barThickness: 10,
                        categoryPercentage: 0.8,
                        barPercentage: 0.9
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { right: 60, left: 10 } },
                    animation: { duration: 0 },
                    plugins: {
                        legend: { display: false },
                        tooltip: tooltipConfig
                    },
                    scales: {
                        x: { 
                            grid: { display: false, drawBorder: false }, 
                            ticks: { color: '#52525b', font: { family: 'Inter', size: 10 } } 
                        },
                        y: { 
                            grid: { display: false, drawBorder: false }, 
                            ticks: { 
                                color: '#a1a1aa', 
                                font: { family: 'Inter', size: 11, weight: 500 },
                                callback: function(value) {
                                    let label = this.getLabelForValue(value);
                                    return label.length > 25 ? label.substring(0, 25) + '...' : label;
                                }
                            } 
                        }
                    }
                }
            });
        }

        function renderAnalytics() {
            if (!State.allData || State.allData.length === 0) return;
            State.charts.analytics.forEach(c => c.destroy());
            State.charts.analytics = [];

            const budget = State.allData.filter(b => b.price < 20).length;
            const mid = State.allData.filter(b => b.price >= 20 && b.price <= 40).length;
            const premium = State.allData.filter(b => b.price > 40).length;

            const ctx1 = document.getElementById('priceDistChart').getContext('2d');
            const chart1 = new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['Budget (<£20)', 'Mid-Range (£20-£40)', 'Premium (>£40)'],
                    datasets: [{
                        data: [budget, mid, premium],
                        backgroundColor: ['#4f46e5', '#818cf8', '#c7d2fe'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true, 
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { 
                            position: 'bottom', 
                            labels: { color: '#a1a1aa', font: { family: 'Inter', size: 11 }, usePointStyle: true, boxWidth: 6, padding: 20 } 
                        },
                        tooltip: tooltipConfig
                    },
                    cutout: '75%'
                }
            });
            State.charts.analytics.push(chart1);

            const cheapest = [...State.allData].sort((a, b) => a.price - b.price).slice(0, 5);
            const ctx2 = document.getElementById('cheapestChart').getContext('2d');

            const chart2 = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: cheapest.map(b => b.title),
                    datasets: [{
                        data: cheapest.map(b => b.price),
                        backgroundColor: '#10b981',
                        borderRadius: 4,
                        borderSkipped: false,
                        barThickness: 10,
                        categoryPercentage: 0.8,
                        barPercentage: 0.9
                    }]
                },
                options: {
                    indexAxis: 'y', 
                    responsive: true, 
                    maintainAspectRatio: false,
                    layout: { padding: { right: 60, left: 10 } },
                    plugins: { 
                        legend: { display: false },
                        tooltip: tooltipConfig
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#52525b', font: { family: 'Inter', size: 10 } } },
                        y: { 
                            grid: { display: false }, 
                            ticks: { 
                                color: '#a1a1aa', 
                                font: { family: 'Inter', size: 11 },
                                callback: function(value) {
                                    let label = this.getLabelForValue(value);
                                    return label.length > 25 ? label.substring(0, 25) + '...' : label;
                                }
                            } 
                        }
                    }
                }
            });
            State.charts.analytics.push(chart2);
        }

        // Boot
        initDashboard();
    </script>
</body>
</html>

