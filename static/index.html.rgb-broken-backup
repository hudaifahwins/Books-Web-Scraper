    <style>
        /* =========================================
           1. UNIFIED DESIGN SYSTEM (Linear/Vercel)
           ========================================= */
        :root {
            /* Surfaces */
            --bg-base: #09090b;
            --bg-surface: #121212;
            --bg-surface-hover: #18181b;
            
            /* Borders */
            --border-subtle: #27272a;
            --border-strong: #3f3f46;
            
            /* Typography */
            --text-primary: #ededed;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            
            /* Accents */
            --accent-indigo: #6366f1;
            --accent-emerald: #10b981;
            --accent-rose: #ef4444;
            
            /* Radii */
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-base);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-feature-settings: "cv02", "cv03", "cv04", "cv11";
        }

        .tabular-nums { font-variant-numeric: tabular-nums; }
        .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

        /* Skeleton Loading */
        .skeleton { background: linear-gradient(90deg, var(--bg-surface) 25%, var(--bg-surface-hover) 50%, var(--bg-surface) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: var(--radius-sm); }
        @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

        /* Fade In */
        .fade-in { animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        /* Ambient Glow */
        .ambient-glow {
            position: absolute; top: 0; left: 50%; transform: translateX(-50%);
            width: 100%; max-width: 800px; height: 300px;
            background: radial-gradient(ellipse at top, rgba(99, 102, 241, 0.08), transparent 70%);
            pointer-events: none; z-index: 0;
        }
    </style>
<style id="bookscraper-rgb-engine">

/* BOOKSCRAPER_RGB_ENGINE_V1 */

/* =========================================
   1. RGB COLOUR SYSTEM
========================================= */

:root {
    --rgb-indigo: #6366f1;
    --rgb-blue: #3b82f6;
    --rgb-cyan: #06b6d4;
    --rgb-emerald: #10b981;
    --rgb-violet: #a855f7;
    --rgb-pink: #ec4899;

    --rgb-duration: 16s;
    --rgb-border: rgba(99,102,241,.25);
}

/* =========================================
   2. ANIMATED AMBIENT BACKGROUND
========================================= */

body {
    background-color: #07070b !important;
    position: relative;
    isolation: isolate;
}

body::before {
    content: "";
    position: fixed;
    inset: -30%;
    z-index: -1;
    pointer-events: none;

    background:
        radial-gradient(
            ellipse at 20% 20%,
            rgba(99,102,241,.16),
            transparent 40%
        ),
        radial-gradient(
            ellipse at 80% 30%,
            rgba(6,182,212,.12),
            transparent 42%
        ),
        radial-gradient(
            ellipse at 50% 85%,
            rgba(168,85,247,.13),
            transparent 42%
        );

    background-size: 160% 160%;
    animation: rgb-ambient 22s ease-in-out infinite alternate;
}

@keyframes rgb-ambient {
    0% {
        transform: translate(-3%, -2%) scale(1);
        filter: hue-rotate(0deg);
    }
    50% {
        transform: translate(3%, 2%) scale(1.06);
        filter: hue-rotate(65deg);
    }
    100% {
        transform: translate(-2%, 3%) scale(1.02);
        filter: hue-rotate(130deg);
    }
}

/* =========================================
   3. RGB GRADIENT TEXT
========================================= */

h1, .page-title {
    background: linear-gradient(
        100deg,
        #818cf8,
        #22d3ee,
        #34d399,
        #a78bfa,
        #818cf8
    );

    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    animation: rgb-text 12s linear infinite;
}

@keyframes rgb-text {
    to {
        background-position: 300% center;
    }
}

/* =========================================
   4. ANIMATED RGB BORDERS
========================================= */

@keyframes rgb-edge {
    0% {
        border-color: rgba(99,102,241,.35);
    }
    25% {
        border-color: rgba(6,182,212,.35);
    }
    50% {
        border-color: rgba(16,185,129,.35);
    }
    75% {
        border-color: rgba(168,85,247,.35);
    }
    100% {
        border-color: rgba(99,102,241,.35);
    }
}

/* Existing premium cards */

.pro-card,
.card,
[data-card] {
    position: relative;
    border: 1px solid var(--rgb-border);
    animation: rgb-edge 16s linear infinite;
    transition:
        transform .3s ease,
        box-shadow .3s ease,
        border-color .3s ease;
}

.pro-card:hover,
.card:hover,
[data-card]:hover {
    transform: translateY(-3px);

    box-shadow:
        0 0 15px rgba(99,102,241,.20),
        0 0 35px rgba(6,182,212,.10);
}

/* =========================================
   5. RGB BUTTON EFFECTS
========================================= */

button {
    transition:
        box-shadow .25s ease,
        border-color .25s ease,
        transform .25s ease;
}

button:hover:not(:disabled) {
    box-shadow:
        0 0 12px rgba(99,102,241,.22),
        0 0 24px rgba(6,182,212,.08);
}

button:active:not(:disabled) {
    transform: scale(.98);
}

/* =========================================
   6. SIDEBAR LIGHTING
========================================= */

aside,
.sidebar {
    background-color: rgba(8,8,14,.94);
    backdrop-filter: blur(18px);
}

aside a,
.sidebar a {
    transition:
        background .3s ease,
        box-shadow .3s ease,
        color .3s ease;
}

aside a:hover,
.sidebar a:hover {
    background: linear-gradient(
        90deg,
        rgba(99,102,241,.16),
        rgba(6,182,212,.08)
    );
    box-shadow: inset 2px 0 #6366f1;
}

aside a[aria-current="page"],
.sidebar a[aria-current="page"] {
    box-shadow:
        inset 2px 0 #818cf8,
        0 0 15px rgba(99,102,241,.12);
}

/* =========================================
   7. SEARCH RGB FOCUS
========================================= */

input:focus,
select:focus,
textarea:focus {
    border-color: #06b6d4 !important;

    box-shadow:
        0 0 0 2px rgba(6,182,212,.12),
        0 0 18px rgba(99,102,241,.16) !important;

    outline: none;
    transition: all .3s ease;
}

/* =========================================
   8. TABLE HOVER LIGHTING
========================================= */

tbody tr {
    transition: background .25s ease;
}

tbody tr:hover {
    background: linear-gradient(
        90deg,
        rgba(99,102,241,.09),
        rgba(6,182,212,.05)
    ) !important;
}

/* =========================================
   9. HEADER GLASS EFFECT
========================================= */

header,
.glass-nav,
.glass-nav {
    backdrop-filter: blur(18px);
}

/* =========================================
   10. RGB SCROLLBAR
========================================= */

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: #09090f;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(
        180deg,
        #6366f1,
        #06b6d4,
        #10b981,
        #a855f7
    );
    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(
        180deg,
        #ec4899,
        #6366f1
    );
}

/* =========================================
   11. RGB SELECTION
========================================= */

::selection {
    background: rgba(99,102,241,.45);
    color: #ffffff;
}

/* =========================================
   12. RGB LOADING ANIMATION
========================================= */

@keyframes rgb-loading {
    0% {
        border-color: #6366f1;
        box-shadow: 0 0 8px rgba(99,102,241,.3);
    }
    33% {
        border-color: #06b6d4;
        box-shadow: 0 0 8px rgba(6,182,212,.3);
    }
    66% {
        border-color: #10b981;
        box-shadow: 0 0 8px rgba(16,185,129,.3);
    }
    100% {
        border-color: #6366f1;
        box-shadow: 0 0 8px rgba(99,102,241,.3);
    }
}

.rgb-loading {
    animation: rgb-loading 3s linear infinite;
}

/* =========================================
   13. CHART CONTAINERS
========================================= */

canvas {
    transition: filter .3s ease;
}

canvas:hover {
    filter: drop-shadow(
        0 0 5px rgba(99,102,241,.12)
    );
}

/* =========================================
   14. FOCUS ACCESSIBILITY
========================================= */

button:focus-visible,
a:focus-visible,
input:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 3px;
}

/* =========================================
   15. REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation: none !important;
        transition: none !important;
    }
}

/* =========================================
   16. MOBILE OPTIMISATION
========================================= */

@media (max-width: 768px) {
    body::before {
        animation-duration: 30s;
    }

    .pro-card:hover,
    .card:hover,
    [data-card]:hover {
        transform: none;
    }
}

</style>
